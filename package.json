{
	"name": "obsidian-customize-discordrpc",
	"version": "1.0.0",
	"description": "Customizable Discord Rich Presence for Obsidian - Shows vault name, note name, and time spent",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix"
	},
	"keywords": [
		"obsidian",
		"discord",
		"rpc",
		"rich-presence",
		"productivity"
	],
	"author": "Ray-kong",
	"license": "MIT",
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.3",
		"@eslint/js": "^9.39.2",
		"@eslint/json": "^0.14.0",
		"@types/node": "^16.11.6",
		"builtin-modules": "3.3.0",
		"esbuild": "0.17.3",
		"eslint": "^9.39.2",
		"eslint-plugin-obsidianmd": "^0.1.9",
		"globals": "^16.5.0",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"typescript": "^5.4.5",
		"typescript-eslint": "^8.50.0"
	},
	"dependencies": {
		"discord-rpc": "^4.0.1",
		"dotenv": "^17.2.2"
	}
}
